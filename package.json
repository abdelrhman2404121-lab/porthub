{
  "name": "portfoliohub",
  "version": "1.0.0",
  "description": "PortfolioHub - Professional Portfolio Platform",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "kill": "npx kill-port 5000",
    "fresh": "npx kill-port 5000 && nodemon app.js",
    "setup": "node -e \"const fs=require('fs');if(!fs.existsSync('.env')){fs.copyFileSync('.env.example','.env');console.log('✅ .env created! Open it and fill in your MONGO_URI.');}else{console.log('✅ .env already exists.');}\"",
    "postinstall": "npm run setup"
  },
  "keywords": [
    "portfolio",
    "professional",
    "networking"
  ],
  "author": "PortfolioHub",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.2.0",
    "mongoose": "^8.3.4",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
